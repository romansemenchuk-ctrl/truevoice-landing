# Скопіюй ці ключі в Vercel → Project Settings → Environment Variables
# (Settings → Environment Variables → Add New). Ніколи не комітити реальний
# .env у git — секретний ключ WayForPay має жити тільки у Vercel.

# WayForPay — кабінет мерчанта → Налаштування → Параметри для API
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
# Домен, зареєстрований у мерчант-акаунті WayForPay для цього сайту
WAYFORPAY_DOMAIN=7d.truevoice.academy

# Товар / ціна, які підуть у чек WayForPay і в подію Purchase пікселя
PRODUCT_NAME=TrueVoice Mini — 7 днів до живого звучання
PRODUCT_PRICE=15
PRODUCT_CURRENCY=USD
