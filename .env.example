# WayForPay — кабінет мерчанта → Налаштування → Параметри для API
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_DOMAIN=7d.truevoice.academy

PRODUCT_NAME=TrueVoice Mini — 7 днів до живого звучання
PRODUCT_PRICE=15
PRODUCT_CURRENCY=USD
PRICE_BASE=15
PRICE_PRO=25
PRICE_UPGRADE=10
SITE_URL=https://7d.truevoice.academy

# Academy ledger bridge. Default in code is off, so existing checkout is unchanged until explicitly enabled.
# Rollout: off -> shadow -> required.
ACADEMY_LEDGER_MODE=shadow
ACADEMY_LEDGER_URL=https://YOUR_ACADEMY_HOST/api/payments
ACADEMY_LEDGER_SECRET=

# SendPulse — чинна видача доступу після підтвердженої оплати.
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_BOOK_ID=
